PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/tourmate
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Kakao REST API 키 (서버 전용) — Local 검색 + Mobility 길찾기(자동차 경로·시간)
# 프론트 지도 SDK용 JavaScript 키(EXPO_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY)와 다름. JS 키는 백엔드에 넣지 마세요.
KAKAO_REST_API_KEY=
APP_BASE_URL=http://localhost:3000
# 운영에서는 APP_BASE_URL을 이용해 https://<host>/api/v1/invites/:code를 자동 발급합니다.
# 별도 HTTPS 초대 도메인을 사용할 때만 아래 값을 덮어씁니다.
INVITE_LINK_BASE=tripmatch://invite
# HTTPS 초대 링크를 앱으로 바로 여는 운영 서명 정보입니다.
# Android: EAS credentials 또는 Play Console의 SHA-256 지문(여러 개면 쉼표 구분)
DURI_ANDROID_PACKAGE=
DURI_ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=
# iOS: <APPLE_TEAM_ID>.<BUNDLE_ID> 형식(여러 앱이면 쉼표 구분)
DURI_IOS_APP_LINK_APP_IDS=
# 쉼표 구분 Web origin. 운영 환경에서는 반드시 하나 이상의 https origin을 설정
CORS_ORIGINS=
TRUST_PROXY_HOPS=0
# 운영 API 문서가 필요할 때만 true
SWAGGER_ENABLED=true
DURI_MAX_ROUTE_SEGMENTS=24
DURI_ROUTE_CONCURRENCY=4
DURI_ANALYSIS_DEADLINE_MS=15000
DURI_REPORT_RETENTION_COUNT=20
# 교통 상황이 포함된 분석 리포트 재사용 시간(기본 10분)
DURI_REPORT_CACHE_TTL_MS=600000
# 입장권 사진 로컬 저장 디렉터리
UPLOAD_DIR=uploads
# 멤버 전용 서명 다운로드. 운영은 JWT와 다른 32자 이상 secret 필수
UPLOAD_SIGNING_SECRET=
UPLOAD_SIGNED_URL_TTL_SEC=900
# 중단된 문서 생성·삭제·TODO 연결 작업을 복구하기 위한 임대 시간
DOCUMENT_MUTATION_LEASE_MS=120000
# 운영에서는 반드시 false. 개발에서도 서명 URL 흐름을 기본 검증
UPLOADS_PUBLIC=false

# 캐시 (없으면 메모리만 사용)
REDIS_URL=
REDIS_KEY_PREFIX=tourmate:

# 한국관광공사 TourAPI (KorService2) — Decoding ServiceKey
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=Tourmate

# 특화 서비스 (키는 KorService2와 동일)
TOUR_RELATED_API_BASE_URL=https://apis.data.go.kr/B551011/TarRlteTarService1
TOUR_HUB_API_BASE_URL=https://apis.data.go.kr/B551011/LocgoHubTarService1
TOUR_DATALAB_API_BASE_URL=https://apis.data.go.kr/B551011/DataLabService
TOUR_CNCTR_API_BASE_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService
