NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/tourmate
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Kakao REST API 키 (서버 전용) — Local 검색 + Mobility 길찾기(자동차 경로·시간)
# 프론트 지도 SDK용 JavaScript 키(EXPO_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY)와 다름. JS 키는 백엔드에 넣지 마세요.
KAKAO_REST_API_KEY=
APP_BASE_URL=http://localhost:3000
# 쉼표로 구분한 브라우저 Origin. React Native 앱 요청은 Origin 헤더가 없어 영향 없음.
CORS_ORIGINS=
# 개발 기본 true, 운영 기본 false. 운영에서 문서가 꼭 필요할 때만 true
SWAGGER_ENABLED=true
# 단일 인스턴스 기준 전역 요청 제한
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
INVITE_LINK_BASE=tripmatch://invite
# 입장권 사진 로컬 저장 디렉터리 (정적 서빙: /uploads/*)
UPLOAD_DIR=uploads
# 멤버 전용 서명 다운로드 (운영 필수, 32자 이상의 별도 비밀값)
UPLOAD_SIGNING_SECRET=
UPLOAD_SIGNED_URL_TTL_SEC=900
# 업로드 파일은 기본 비공개. 레거시 공개 URL 호환이 꼭 필요한 경우에만 true
UPLOADS_PUBLIC=false

# 캐시 (없으면 메모리만 사용)
REDIS_URL=
REDIS_KEY_PREFIX=tourmate:

# 한국관광공사 TourAPI (KorService2) — Decoding ServiceKey
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=Tourmate

# 특화 서비스 (키는 KorService2와 동일)
TOUR_RELATED_API_BASE_URL=https://apis.data.go.kr/B551011/TarRlteTarService1
TOUR_HUB_API_BASE_URL=https://apis.data.go.kr/B551011/LocgoHubTarService1
TOUR_DATALAB_API_BASE_URL=https://apis.data.go.kr/B551011/DataLabService
TOUR_CNCTR_API_BASE_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService
